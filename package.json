{
  "name": "parley-b2b-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Two companies, two databases, one conversation: signed events, idempotent handoff, a consent-aware outbox, signed document links and encrypted fields.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "transcripts": "tsx scripts/record-transcripts.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/static": "8.0.3",
    "fastify": "5.2.0",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
